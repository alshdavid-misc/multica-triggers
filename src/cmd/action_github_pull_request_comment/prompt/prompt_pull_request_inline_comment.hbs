<review_comment type="inline">
  <comment_id>{{comment_id}}</comment_id>
  <file>{{safe path}}</file>
  {{#if line}}
  <line>{{line}}</line>
  {{#if start_line}}<start_line>{{start_line}}</start_line>{{/if}}
  {{else}}
  <line outdated="true">{{original_line}}</line>
  {{/if}}
  <commit>{{commit_sha}}</commit>
  {{#if is_reply}}
  <thread id="{{thread_id}}">Follow-up in an existing thread. See earlier comments with the same thread ID.</thread>
  {{/if}}
  <diff_hunk>
{{safe diff_hunk}}
  </diff_hunk>
  <comment>
{{safe body}}
  </comment>
</review_comment>